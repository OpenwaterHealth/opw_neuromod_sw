# Auto detect text files and perform LF normalization
* text=auto

# MATLAB files
*.m text eol=lf linguist-language=MATLAB
*.mlx binary
*.mat binary
*.fig binary
*.p binary
*.slx binary
*.mdl binary

# Scripts
*.sh text eol=lf
*.bat text eol=crlf

# Documentation
*.md text eol=lf
*.txt text eol=lf
README text eol=lf
LICENSE text eol=lf

# Configuration files
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.toml text eol=lf

# Git
.gitattributes text eol=lf
.gitignore text eol=lf
.gitkeep text eol=lf

# Archives
*.zip binary
*.tar binary
*.gz binary
*.7z binary
*.rar binary

# Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text eol=lf
*.nii binary